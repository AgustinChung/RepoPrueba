@startuml


actor Main
participant Juego
participant Guerrero
participant Ubicacion
participant MisionSecundaria



Main -> Juego: aumentarExperienciaPersonaje(personaje: Guerrero): int
Juego -> Guerrero: subirNivelExperiencia(nivel: int): int
Guerrero -> Ubicacion: viajarAUbicacion(ubicacion: Ubicacion): void
Ubicacion -> Ubicacion: esNeutral():

alt Ubicacion neutral 
Ubicacion -> Ubicacion: getMisionSecundaria()
Ubicacion -> MisionSecundaria: getMisionCompleta(): boolean
MisionSecundaria --> Ubicacion: True



else Ubicacion no es neutral
end


@enduml